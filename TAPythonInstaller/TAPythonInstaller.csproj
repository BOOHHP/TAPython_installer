<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.16.1</Version>
    <AssemblyVersion>1.16.1.0</AssemblyVersion>
    <FileVersion>1.16.1.0</FileVersion>
    <InformationalVersion>1.16.1</InformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Default publish output: <workspace>\dist -->
    <PublishDir>$(MSBuildThisFileDirectory)..\dist\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\AppIcon.ico"/>
    <Resource Include="Assets\AppIcon.ico"/>
    <None Remove="Assets\noise.png"/>
    <Resource Include="Assets\noise.png"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Shaders\Refraction.ps"/>
    <Resource Include="Shaders\Refraction.ps"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Skills\tapython-generator.zip"/>
    <None Remove="Assets\Skills\tapython-hub-publisher.zip"/>
    <None Remove="Assets\Skills\ue-api-navigator.zip"/>
    <EmbeddedResource Include="Assets\Skills\tapython-generator.zip" LogicalName="Skills.tapython-generator.zip"/>
    <EmbeddedResource Include="Assets\Skills\tapython-hub-publisher.zip" LogicalName="Skills.tapython-hub-publisher.zip"/>
    <EmbeddedResource Include="Assets\Skills\ue-api-navigator.zip" LogicalName="Skills.ue-api-navigator.zip"/>
    <EmbeddedResource Include="Assets\Agents\ue5-scene-art-tool-dev.agent.md" LogicalName="Agents.ue5-scene-art-tool-dev.agent.md"/>
  </ItemGroup>

  <ItemGroup>
    <!-- System.Windows.Shapes.Path conflicts with System.IO.Path; remove it since we don't use WPF shapes -->
    <Using Remove="System.Windows.Shapes"/>
  </ItemGroup>

</Project>